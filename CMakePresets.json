{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 27,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTING": false,
                "CMAKE_INSTALL_PREFIX": "/opt/robotFarm",
                "CMAKE_CUDA_ARCHITECTURES": "75;80",
                "ROBOT_FARM_OPENCV_WITH_NON_FREE_CONTRIB": false
            }
        },
        {
            "name": "shared",
            "hidden": true,
            "cacheVariables": { "BUILD_SHARED_LIBS": true }
        },
        {
            "name": "static",
            "hidden": true,
            "cacheVariables": { "BUILD_SHARED_LIBS": false }
        },
        {
            "name": "clang",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_Fortran_COMPILER": "flang",
                "CMAKE_CUDA_HOST_COMPILER": "clang++",
                "CMAKE_CUDA_FLAGS": "-allow-unsupported-compiler"
            }
        },
        {
            "name": "gnu",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_Fortran_COMPILER": "gfortran",
                "CMAKE_CUDA_HOST_COMPILER": "g++"
            }
        },

        {
            "name": "clang-shared",
            "displayName": "Clang Shared (CI)",
            "description": "CI preset: default Clang toolchain, shared libraries",
            "inherits": ["base", "shared", "clang"]
        },
        {
            "name": "clang-static",
            "displayName": "Clang Static (CI)",
            "description": "CI preset: default Clang toolchain, static libraries",
            "inherits": ["base", "static", "clang"]
        },
        {
            "name": "gnu-shared",
            "displayName": "GNU Shared (CI)",
            "description": "CI preset: default GNU toolchain, shared libraries",
            "inherits": ["base", "shared", "gnu"]
        },
        {
            "name": "gnu-static",
            "displayName": "GNU Static (CI)",
            "description": "CI preset: default GNU toolchain, static libraries",
            "inherits": ["base", "static", "gnu"]
        }
    ]
}
