+      list(APPEND CMAKE_CUDA_ARCHITECTURES "75")
+    endif()
+    if (CUDAToolkit_VERSION VERSION_GREATER_EQUAL "11.0")
+      # Support Ampere GPUs.
+      list(APPEND CMAKE_CUDA_ARCHITECTURES "80")
+    endif()
+    if (CUDAToolkit_VERSION VERSION_GREATER_EQUAL "12.0")
