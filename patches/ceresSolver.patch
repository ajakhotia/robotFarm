+  # A user-supplied CMAKE_CUDA_ARCHITECTURES takes precedence, per CMake's contract for
+  # the variable. Only when none was given, default to the GPU generations this toolkit
+  # supports. Either way the value must be in place before enable_language(CUDA), which
+  # is where CMake validates and consumes it.
+  if (NOT DEFINED CMAKE_CUDA_ARCHITECTURES)
+    set(CMAKE_CUDA_ARCHITECTURES "")
+    if (CUDAToolkit_VERSION VERSION_LESS "13.0")
+      # Support Maxwell GPUs.
+      list(APPEND CMAKE_CUDA_ARCHITECTURES "50")
+      if (CUDAToolkit_VERSION VERSION_GREATER_EQUAL "8.0")
+        # Support Pascal GPUs.
+        list(APPEND CMAKE_CUDA_ARCHITECTURES "60")
+      endif()
+      if (CUDAToolkit_VERSION VERSION_GREATER_EQUAL "9.0")
+        # Support Volta GPUs.
+        list(APPEND CMAKE_CUDA_ARCHITECTURES "70")
+      endif()
     endif()
